# Backend Environment Variables
# Port assigned automatically by Render or defaults to 5000
PORT=5000

# Allowed frontend URL(s) for CORS (comma-separated if multiple)
# FRONTEND_URL=https://your-revive-frontend.onrender.com
# CORS_ORIGIN=https://your-revive-frontend.onrender.com

# Optional database path (if using Render Persistent Disk, e.g. /var/data/revive_motion.db)
# DB_PATH=./data/revive_motion.db
